# ==========================================================================
# SchemeSetu - environment template (copy to .env and fill in)
# Codebenders ACE Builders Hackathon 2026  |  Problem Statement 5
# ==========================================================================
# Everything below has a safe default: the app runs 100% without any API key.
# Keys only *upgrade* the experience (natural-language intake, local-language
# explanations, drafted reminders). The eligibility engine is deterministic and
# never depends on a model.

# ------------------------------- App -------------------------------------
APP_NAME=SchemeSetu
APP_ENV=dev
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Region we launched for (product decision: Telangana, low-income families)
STATE_FOCUS=Telangana
DEFAULT_LANGUAGE=en-IN

# ------------------------------- Data ------------------------------------
SCHEMES_PATH=data/schemes.json
SAMPLE_PROFILES_PATH=data/sample_profiles.json
DB_PATH=data/app.db
# Refuse to run if the curated scheme data is older than this many days
DATA_STALE_AFTER_DAYS=180

# ---------------------- Guardrail: PII redaction --------------------------
# When 1, Aadhaar / PAN / phone / bank-account numbers are redacted from every
# transcript BEFORE it is stored or sent anywhere. Never set to 0 in a demo.
PII_REDACTION=1
# Hard block: the product must never collect Aadhaar numbers (PS5 guardrail)
BLOCK_SENSITIVE_IDS=1

# ------------------- Data rights: DPDP Act 2023 ----------------------------
# Retention window. The sweep at startup (and POST /api/privacy/purge) erases
# households older than this. A citizen can also export everything we hold
# (GET /api/profiles/{id}/export) or erase it (DELETE /api/profiles/{id}).
DATA_RETENTION_DAYS=90
# When 1, an intake without consent=true is refused and the consent notice is
# enforced (/api/consent/notice). A real deployment should run with this on;
# the demo leaves it off so a judge can click through in a hurry.
CONSENT_REQUIRED=0

# ---------------------- Graphify integration ------------------------------
# graphify (https://github.com/Graphify-Labs/graphify) turns a corpus of
# markdown/PDF docs into a queryable knowledge graph (nodes + links, each edge
# tagged EXTRACTED | INFERRED | AMBIGUOUS).
#   pip install graphifyy && graphify extract corpus --backend openai
# The file below is auto-imported into the Reasoning Graph when it exists.
GRAPHIFY_OUT=graphify-out/graph.json
GRAPHIFY_CORPUS=corpus
GRAPHIFY_AUTO_IMPORT=1
# Optional: let Graphify use its own backend env vars (it honours OPENAI_*,
# GEMINI_*, ANTHROPIC_*, OLLAMA_*, MOONSHOT_* itself).

# ---------------------- LLM layer: Groq + OpenRouter ----------------------
# Only these two providers are wired in. Both are OpenAI-compatible so they
# share one client. auto = use whichever key is present (Groq first).
# off = never call a model. The app always falls back to deterministic logic.
LLM_ENABLED=auto
# auto | groq | openrouter
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=45

# --- Groq: https://console.groq.com/keys ---------------------------------
# Very fast + generous free tier. Check the model list on your own account
# (GET /openai/v1/models) - the available ids differ per account.
# On the hackathon coupon account, these were available:
#   openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Groq Whisper gives us server-side speech-to-text, which is how a person who
# types Telugu/Hindi poorly can just speak (PS5: "typed or spoken, in a
# regional language if you can"). Works in every browser, unlike Web Speech.
GROQ_STT_ENABLED=1
# gpt-oss / reasoning models on Groq spend tokens thinking. "low" keeps replies
# fast and stops the token budget being eaten before any content is produced.
GROQ_REASONING_EFFORT=low
GROQ_STT_MODEL=whisper-large-v3

# --- OpenRouter: https://openrouter.ai/keys ------------------------------
# One key, many models. Swap in any model id, including ":free" variants,
# e.g. openrouter model list: meta-llama/llama-3.3-70b-instruct,
# google/gemma-2-9b-it:free, qwen/qwen-2.5-72b-instruct.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OpenRouter recommends attribution headers (shown on their dashboard)
OPENROUTER_REFERER=http://localhost:8000
OPENROUTER_TITLE=SchemeSetu

# --- Optional: reuse the same key for graphify's own LLM extraction -------
# graphify (pip install graphifyy) reads OPENAI_* because it is
# OpenAI-compatible. Point it at OpenRouter/Groq to avoid a second key:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=<your OPENROUTER_API_KEY>
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
